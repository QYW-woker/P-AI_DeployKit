#!/bin/bash

# DeployKit Pro 启动/重启脚本
# 用法: ./restart [端口号]
# 示例: ./restart 9000

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="$SCRIPT_DIR/.deploykit.pid"
LOG_FILE="$SCRIPT_DIR/deploykit.log"
DEFAULT_PORT=3000

# 获取端口参数
PORT=${1:-$DEFAULT_PORT}

# 颜色定义
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${CYAN}"
echo "╔═══════════════════════════════════════════════════╗"
echo "║   🚀 DeployKit Pro - 启动脚本                      ║"
echo "╚═══════════════════════════════════════════════════╝"
echo -e "${NC}"

# 检查是否有运行中的进程
if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE")
    if kill -0 "$OLD_PID" 2>/dev/null; then
        echo -e "${YELLOW}⚠ 检测到运行中的服务 (PID: $OLD_PID)，正在停止...${NC}"
        kill "$OLD_PID" 2>/dev/null
        sleep 2
        # 强制终止
        if kill -0 "$OLD_PID" 2>/dev/null; then
            kill -9 "$OLD_PID" 2>/dev/null
        fi
        echo -e "${GREEN}✓ 旧服务已停止${NC}"
    fi
    rm -f "$PID_FILE"
fi

# 检查 Node.js 是否安装
if ! command -v node &> /dev/null; then
    echo -e "${RED}✗ 错误: 未找到 Node.js，请先安装 Node.js${NC}"
    exit 1
fi

# 检查依赖是否安装
if [ ! -d "$SCRIPT_DIR/node_modules" ]; then
    echo -e "${YELLOW}⚠ 未检测到 node_modules，正在安装依赖...${NC}"
    cd "$SCRIPT_DIR" && npm install
fi

# 启动服务
echo -e "${GREEN}▶ 正在启动服务...${NC}"
echo -e "  端口: ${CYAN}$PORT${NC}"
echo -e "  日志: ${CYAN}$LOG_FILE${NC}"

cd "$SCRIPT_DIR"
PORT=$PORT nohup node backend/server.js > "$LOG_FILE" 2>&1 &
NEW_PID=$!

# 保存 PID
echo $NEW_PID > "$PID_FILE"

# 等待服务启动
sleep 2

# 检查服务是否启动成功
if kill -0 "$NEW_PID" 2>/dev/null; then
    echo ""
    echo -e "${GREEN}╔═══════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║   ✓ DeployKit Pro 启动成功!                        ║${NC}"
    echo -e "${GREEN}╠═══════════════════════════════════════════════════╣${NC}"
    echo -e "${GREEN}║   📡 访问地址: http://localhost:$PORT               ${NC}"
    echo -e "${GREEN}║   📋 进程 PID: $NEW_PID                              ${NC}"
    echo -e "${GREEN}╚═══════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "查看日志: ${CYAN}tail -f $LOG_FILE${NC}"
    echo -e "停止服务: ${CYAN}./stop${NC}"
else
    echo -e "${RED}✗ 服务启动失败，请检查日志: $LOG_FILE${NC}"
    rm -f "$PID_FILE"
    exit 1
fi
